# ============================================================================
# NexusQuantum WMS — Multi-Environment Persistence Configuration
# ============================================================================
# 1. DEVELOP MODE (Default when DATABASE_URL is empty):
#    Automatically boots persistent PostgreSQL 18.6 on disk at ./.pgdata-dev
#
# 2. TEST MODE (npm test / NODE_ENV=test):
#    Automatically boots isolated ephemeral PostgreSQL 18.6 for Vitest suites
#
# 3. DEPLOY MODE (Cloud Supabase / Neon / Docker PostgreSQL 18):
#    Set DATABASE_URL below to switch automatically to pooled cloud Postgres.
#    Connected Supabase project ref: pmkdvlrjjkvkoxlqqcqx (myscantool)
# ============================================================================

NEXT_PUBLIC_SUPABASE_PROJECT_REF=pmkdvlrjjkvkoxlqqcqx
NEXT_PUBLIC_SUPABASE_URL=https://pmkdvlrjjkvkoxlqqcqx.supabase.co
