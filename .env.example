# ============================================================================
# NexusQuantum WMS — Multi-Environment Persistence Configuration
# ============================================================================
# 1. DEVELOP MODE (Default when DATABASE_URL is empty):
#    Automatically boots persistent PostgreSQL 18.6 on disk at ./.pgdata-dev
#
# 2. TEST MODE (npm test / NODE_ENV=test):
#    Automatically boots isolated ephemeral PostgreSQL 18.6 for Vitest suites
#
# 3. DEPLOY MODE (Cloud Supabase / Neon / Docker PostgreSQL 18):
#    Set DATABASE_URL and WMS_AUTH_USER / WMS_AUTH_PASSWORD.
#    Connected Supabase project ref: pmkdvlrjjkvkoxlqqcqx (myscantool)
# ============================================================================

NEXT_PUBLIC_SUPABASE_PROJECT_REF=pmkdvlrjjkvkoxlqqcqx
NEXT_PUBLIC_SUPABASE_URL=https://pmkdvlrjjkvkoxlqqcqx.supabase.co
# DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.pmkdvlrjjkvkoxlqqcqx.supabase.co:5432/postgres
# DATABASE_SSL=require

# Required whenever DATABASE_URL is set. Use a unique password with at least 16 characters.
WMS_AUTH_USER=
WMS_AUTH_PASSWORD=

# Optional comma-separated exact browser origins for cross-origin integrations.
# Leave empty to allow same-origin browser requests only.
WMS_ALLOWED_ORIGINS=

# Docker Compose development values; replace every blank value before starting Compose.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
